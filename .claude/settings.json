{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "REPO_ROOT": "${CLAUDE_PROJECT_DIR}"
  },
  "permissions": {
    "allow": [],
    "additionalDirectories": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/analytics/show-session-tokens.py\" --from-hook 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "◉ Token ledger"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/runtime/suggest-next.py\" --from-hook 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Runtime suggestions check"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/analytics/harvest-session-tokens.py\" --from-hook --project poc-hagenthon-2026 || true",
            "timeout": 30,
            "statusMessage": "Analytics: harvest token usage (EP-013 dogfooding)"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true
  }
}
